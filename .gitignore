__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
build/
dist/
*.egg-info/
.eggs/

# ─── Node / npm ──────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json

# ─── User-uploaded evidence files ────────────────────
static/uploads/

